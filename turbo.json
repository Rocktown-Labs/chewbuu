{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SENTRY_AUTH_TOKEN"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:portless": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORTLESS",
        "PORTLESS_HTTPS",
        "PORTLESS_LAN",
        "PORTLESS_LAN_IP",
        "PORTLESS_NGROK",
        "PORTLESS_PORT",
        "PORTLESS_STATE_DIR",
        "PORTLESS_SYNC_HOSTS",
        "PORTLESS_TAILSCALE",
        "PORTLESS_TLD",
        "PORTLESS_WILDCARD"
      ]
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "BLOCKS_MIGRATION_DB_URL",
        "CHEWBUU_STAGE",
        "DATABASE_CA_CERT",
        "DATABASE_URL"
      ]
    }
  }
}
