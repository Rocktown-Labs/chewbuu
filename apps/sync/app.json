{
  "expo": {
    "scheme": "chewbuu-sync",
    "userInterfaceStyle": "dark",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "Chewbuu Sync",
    "slug": "chewbuu-sync",
    "ios": {
      "bundleIdentifier": "com.chewbuu.sync",
      "supportsTablet": true,
      "requireFullScreen": false,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.chewbuu.sync",
      "supportsTablet": true,
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
