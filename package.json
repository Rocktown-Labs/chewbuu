{
  "name": "chewbuu",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "tsx": "^4.22.5",
      "better-auth": "1.6.23",
      "evlog": "^2.19.2",
      "ai": "^7.0.13",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "@tanstack/react-form": "^1.33.0",
      "@ai-sdk/react": "^4.0.14",
      "@types/react-dom": "^19.2.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.23"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "portless:proxy": "portless proxy start",
    "portless:dev": "turbo run dev:portless",
    "dev:blocks": "tsx packages/aws-blocks/aws-blocks/scripts/server.ts",
    "aws:deploy": "tsx packages/aws-blocks/aws-blocks/scripts/deploy.ts",
    "aws:sandbox": "tsx packages/aws-blocks/aws-blocks/scripts/sandbox.ts",
    "db:migrate": "turbo run db:migrate -F @chewbuu/aws-blocks",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@chewbuu/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chewbuu/config": "workspace:*",
    "@types/node": "^22.13.14",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "portless": "0.15.6",
    "tsx": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "^6",
    "ultracite": "7.9.3"
  },
  "packageManager": "bun@1.3.14"
}
